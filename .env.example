GH_PAT= # GitHub token used to fetch your Obsidian vault notes and the repositories page
VAULT_REPO= # GitHub "owner/repo" that holds your Obsidian vault (e.g. your-user/your-vault)
LOCAL_VAULT_PATH=../vault-obsidian # Optional local vault path, read instead of VAULT_REPO when the folder exists
USE_REMOTE_VAULT=false # Set to true to force the remote VAULT_REPO even when LOCAL_VAULT_PATH exists
VAULT_SYNC_INTERVAL_MS=60000 # Remote vault polling interval for `npm run dev` and self-hosted `npm start` (default: 60000 = 1 minute)
DEPLOY_HOOK_URL= # Optional deploy hook (e.g. a Vercel Deploy Hook) that `npm start` / `npm run sync:vault` calls when the vault HEAD changes
