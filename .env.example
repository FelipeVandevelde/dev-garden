GH_PAT= # Required for fetching Obsidian markdown notes from external vault
LOCAL_VAULT_PATH=../vault-obsidian # Optional local vault path for live sync during astro dev
USE_REMOTE_VAULT=false # Set to true to force remote GitHub vault fetching even when LOCAL_VAULT_PATH exists
VAULT_SYNC_INTERVAL_MS=60000 # Remote vault polling interval in milliseconds (default: 60000 = 1 minute)
DEPLOY_HOOK_URL= # Optional server/Netlify Build Hook URL triggered when remote vault HEAD changes
