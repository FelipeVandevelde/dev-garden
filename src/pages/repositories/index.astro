---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RepositoryCard from '../../components/RepositoryCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getCollection } from 'astro:content';

const allRepos = await getCollection('repositories');
const allTags = Array.from(new Set(allRepos.flatMap(r => r.data.tags)));
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      &gt; REPOSITORIES // SANDBOX ENVIRONMENTS &amp; SCRIPTS
    </div>
    <FilterBar tags={allTags} />
    <div class="project-grid" style="margin-top: 24px;">
      {allRepos.map(r => <RepositoryCard repo={r.data} />)}
    </div>
  </div>
</BaseLayout>