---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import Constellation from '../../components/Constellation.astro';
import CommitStream from '../../components/CommitStream.astro';

const profile = await getEntry('profile', 'pt-br');
---
<BaseLayout>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-bio">
        <h1 class="display-title">{profile?.data.name} &mdash; {profile?.data.title}</h1>
        <p class="bio-p">{profile?.data.bio}</p>
        <div class="system-status">
          &gt; STATUS_SISTEMA: OPERACIONAL &mdash; MONOCROMÁTICO &mdash; WCAG_AAA
        </div>
      </div>
      <div class="metrics-card">
        <div class="metric-item"><span>EXPERIÊNCIA (ANOS)</span><span class="metric-val">10+</span></div>
        <div class="metric-item"><span>SISTEMAS EM PRODUÇÃO</span><span class="metric-val">14</span></div>
        <div class="metric-item"><span>NOTAS DO JARDIM</span><span class="metric-val">42</span></div>
        <div class="metric-item"><span>PONTUAÇÃO LIGHTHOUSE</span><span class="metric-val">100 / 100</span></div>
      </div>
    </div>

    <div class="section-header">&gt; CONSTELAÇÃO DE HABILIDADES INTERATIVA (CLIQUE PARA FILTRAR)</div>
    <Constellation />

    <div class="activity-stream">
      <div class="section-header">&gt; FLUXO DE REVISÕES DO GITHUB AO VIVO</div>
      <CommitStream />
    </div>
  </div>
</BaseLayout>