---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

interface GraphNode {
  id: string;
  title: string;
  status: string;
}

interface GraphLink {
  source: string;
  target: string;
}

interface AdjacencyRecord {
  node: GraphNode;
  in: GraphNode[];
  out: GraphNode[];
}

const graphPath = path.join(process.cwd(), 'public', 'graph-data.json');
let nodes: GraphNode[] = [];
let links: GraphLink[] = [];

if (fs.existsSync(graphPath)) {
  const data = JSON.parse(fs.readFileSync(graphPath, 'utf8'));
  nodes = data.nodes;
  links = data.links;
}

const adjacency: Record<string, AdjacencyRecord> = {};
nodes.forEach(n => {
  adjacency[n.id] = { node: n, in: [], out: [] };
});
links.forEach(l => {
  if (adjacency[l.source] && adjacency[l.target]) {
    adjacency[l.source].out.push(adjacency[l.target].node);
    adjacency[l.target].in.push(adjacency[l.source].node);
  }
});
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      &gt; GRAFO DE CONHECIMENTO // MAPA VISUAL 2D (MONOCROMÁTICO)
    </div>

    <div id="graph-container" class="graph-container" style="position: relative; overflow: hidden; touch-action: none;">
      <p style="text-align: center; padding: 2rem; border: var(--border-width) dashed var(--text-color); font-family: var(--font-mono); font-size: 12px;">[ INICIALIZANDO GRAFO... ]</p>
    </div>

    <nav class="graph-fallback" aria-label="Graph Fallback Navigation">
      {nodes.map(n => (
        <div class="node-list-item" style="margin-bottom: 2rem; border-bottom: var(--border-width) dotted var(--text-color); padding-bottom: 1rem;">
          <h3><a href={`/garden/${n.id}`}>{n.title}</a> <span class={`badge badge-${n.status}`}>[{n.status.toUpperCase()}]</span></h3>
          
          <div style="margin-top: 1rem;">
            <strong>Mentions (Outgoing):</strong>
            {adjacency[n.id].out.length > 0 ? (
              <ul style="list-style: circle; margin-left: 2rem;">
                {adjacency[n.id].out.map(outNode => (
                  <li><a href={`/garden/${outNode.id}`}>{outNode.title}</a></li>
                ))}
              </ul>
            ) : <span style="opacity: 0.6; margin-left: 0.5rem;">None</span>}
          </div>

          <div style="margin-top: 1rem;">
            <strong>Referenced by (Incoming):</strong>
            {adjacency[n.id].in.length > 0 ? (
              <ul style="list-style: square; margin-left: 2rem;">
                {adjacency[n.id].in.map(inNode => (
                  <li><a href={`/garden/${inNode.id}`}>{inNode.title}</a></li>
                ))}
              </ul>
            ) : <span style="opacity: 0.6; margin-left: 0.5rem;">None</span>}
          </div>
        </div>
      ))}
    </nav>
  </div>

  <script>
    import * as d3 from 'd3';

    let simulation: any = null;

    async function initGraph() {
      const container = document.getElementById('graph-container');
      if (!container) return;

      if (window.innerWidth < 768) {
        container.innerHTML = '';
        if (window.graphSimulation) window.graphSimulation.stop();
        return;
      }

      try {
        const res = await fetch('/graph-data.json');
        const data = await res.json();
        
        const width = container.clientWidth;
        const height = container.clientHeight;
        
        container.innerHTML = '';
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        container.appendChild(canvas);
        
        const context = canvas.getContext('2d');
        if (!context) return;

        const style = getComputedStyle(document.body);
        const textColor = style.getPropertyValue('--text-color').trim() || '#000';
        const bgColor = style.getPropertyValue('--bg-color').trim() || '#fff';

        const degree: Record<string, number> = {};
        data.nodes.forEach((n: any) => degree[n.id] = 0);
        data.links.forEach((l: any) => {
          degree[l.source]++;
          degree[l.target]++;
        });

        const nodes = data.nodes.map((d: any) => Object.create(d));
        const links = data.links.map((d: any) => Object.create(d));

        simulation = d3.forceSimulation(nodes)
            .force("link", d3.forceLink(links).id((d: any) => d.id).distance(150))
            .force("charge", d3.forceManyBody().strength(-400))
            .force("center", d3.forceCenter(width / 2, height / 2));

        let currentTransform = d3.zoomIdentity;

        function ticked() {
          if (!context) return;
          context.save();
          context.clearRect(0, 0, width, height);
          context.translate(currentTransform.x, currentTransform.y);
          context.scale(currentTransform.k, currentTransform.k);

          context.beginPath();
          links.forEach((d: any) => {
            context.moveTo(d.source.x, d.source.y);
            context.lineTo(d.target.x, d.target.y);
          });
          context.strokeStyle = textColor;
          context.globalAlpha = 0.2;
          context.stroke();
          context.globalAlpha = 1.0;

          nodes.forEach((d: any) => {
            context.beginPath();
            const r = 5 + (degree[d.id] || 0) * 2;
            d.r = r;
            context.moveTo(d.x + r, d.y);
            context.arc(d.x, d.y, r, 0, 2 * Math.PI);
            context.fillStyle = bgColor;
            context.fill();
            context.strokeStyle = textColor;
            context.lineWidth = 2;
            context.stroke();

            context.fillStyle = textColor;
            context.font = "12px monospace";
            context.fillText(d.title, d.x + r + 6, d.y + 4);
          });
          
          context.restore();
        }

        simulation.on("tick", ticked);

        d3.select(canvas).call(d3.zoom<HTMLCanvasElement, unknown>()
            .scaleExtent([0.1, 4])
            .on("zoom", (e: any) => {
               currentTransform = e.transform;
               ticked();
            }));

        canvas.addEventListener('click', (e) => {
          const rect = canvas.getBoundingClientRect();
          const mx = (e.clientX - rect.left - currentTransform.x) / currentTransform.k;
          const my = (e.clientY - rect.top - currentTransform.y) / currentTransform.k;
          
          let closest: any = null;
          let minDist = Infinity;
          nodes.forEach((d: any) => {
            const dx = mx - d.x;
            const dy = my - d.y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < d.r + 5 && dist < minDist) {
              minDist = dist;
              closest = d;
            }
          });

          if (closest) {
            const langPrefix = document.documentElement.lang === 'pt-br' ? '/pt-br' : '';
            window.location.href = `${langPrefix}/garden/${closest.id}`;
          }
        });
        
        canvas.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          const mx = (e.clientX - rect.left - currentTransform.x) / currentTransform.k;
          const my = (e.clientY - rect.top - currentTransform.y) / currentTransform.k;
          
          let found = false;
          nodes.forEach((d: any) => {
            const dx = mx - d.x;
            const dy = my - d.y;
            if (Math.sqrt(dx*dx + dy*dy) < d.r + 5) found = true;
          });
          canvas.style.cursor = found ? 'pointer' : 'grab';
        });

      } catch(e) {
        console.error("Graph init failed:", e);
      }
    }

    let timeout: any;
    window.addEventListener('resize', () => {
      clearTimeout(timeout);
      timeout = setTimeout(initGraph, 250);
    });

    initGraph();
  </script>
</BaseLayout>