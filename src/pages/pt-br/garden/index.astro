---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import GardenCard from '../../components/GardenCard.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('garden', ({ data, id }) => {
  return data.draft !== true && !id.startsWith('_');
});

const allStatuses = Array.from(new Set(allNotes.map(n => n.data.status)));
---
<BaseLayout>
  <section>
    <h2>Digital Garden</h2>
    <p style="margin-bottom: 2rem;">A collection of notes and thoughts.</p>
    
    <FilterBar tags={allStatuses} />

    <div class="garden-list" style="margin-top: 2rem;">
      {allNotes.map(note => {
        const translatedStatus = note.data.status === "sprout" ? "SEED" : note.data.status === "growing" ? "EXPANDING" : "PRODUCTION";
        const icon = note.data.status === "sprout" ? "◇" : note.data.status === "growing" ? "◐" : "●";
        return (
          <GardenCard 
            note={note} 
            prefix="NOTA DO JARDIM"
            translatedStatus={translatedStatus}
            icon={icon}
          />
        );
      })}
    </div>
  </section>
</BaseLayout>