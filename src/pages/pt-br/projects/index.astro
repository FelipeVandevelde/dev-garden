---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const allTags = Array.from(new Set(allProjects.flatMap(p => p.data.tags)));
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      &gt; PROJETOS // ESTUDOS DE CASO DE ENGENHARIA PRINCIPAIS
    </div>
    <FilterBar tags={allTags} />
    <div class="project-grid" style="margin-top: 24px;">
      {allProjects.map(p => <ProjectCard slug={p.id} project={p.data} />)}
    </div>
  </div>
</BaseLayout>