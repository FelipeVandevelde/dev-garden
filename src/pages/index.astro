---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import Constellation from '../components/Constellation.astro';
import CommitStream from '../components/CommitStream.astro';

const profile = await getEntry('profile', 'en');
---
<BaseLayout>
  <section class="hero-section">
    <h1>{profile?.data.name}</h1>
    <h2>{profile?.data.title}</h2>
    <p class="bio">{profile?.data.bio}</p>
    
    <h3>Core Principles</h3>
    <ul>
      {profile?.data.principles.map(p => <li>{p}</li>)}
    </ul>
  </section>
  <section>
    <h3>Skill Constellation</h3>
    <Constellation />
  </section>
  <section>
    <CommitStream />
  </section>
</BaseLayout>