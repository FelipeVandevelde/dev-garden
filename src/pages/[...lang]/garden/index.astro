---
import { siteConfig } from '../../../site.config';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  return siteConfig.locale.supported.map(lang => ({
    params: { lang: lang === siteConfig.locale.default ? undefined : lang }
  }));
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilterBar from '../../../components/FilterBar.astro';
import GardenCard from '../../../components/GardenCard.astro';
import BaseCard from '../../../components/BaseCard.astro';
import { getCollection } from 'astro:content';

const langDir = Astro.params.lang === 'pt-br' ? 'pt-br' : 'en';
const prefix = langDir === 'pt-br' ? '/pt-br' : '';
const t = useTranslations((Astro.params.lang as 'en' | 'pt-br') || 'en');
const allNotes = await getCollection('garden', ({ data, id }) => {
  if (!id.startsWith(langDir + '/')) return false;
  return data.draft !== true && !id.includes('/_');
});

function getNoteFolder(noteId: string): string {
  const rawSlug = noteId.split('/').slice(1).join('/').replace(/\.(md|mdx)$/i, '').replace(/^\/+/, '');
  const segments = rawSlug.split('/');
  return segments.length > 1 ? `${segments.slice(0, -1).join('/')}/` : '';
}

const folderCounts = new Map<string, number>();
for (const note of allNotes) {
  const folder = getNoteFolder(note.id);
  if (folder) {
    folderCounts.set(folder, (folderCounts.get(folder) || 0) + 1);
  }
}

const allFolders = Array.from(folderCounts.keys());
const allStatuses = Array.from(new Set(allNotes.map(n => n.data.status)));
const filterTags = [...allStatuses, ...allFolders];
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      {t('garden.title')}
    </div>
    <FilterBar tags={filterTags} emptyMessage={t('garden.empty') || '// No data found'} />

    <div class="garden-list" style="margin-top: 2rem;">
      {allFolders.map(folderName => {
        const count = folderCounts.get(folderName) || 0;
        const folderHref = `${prefix}/garden?folder=${encodeURIComponent(folderName)}`;
        return (
          <BaseCard
            href={folderHref}
            class="base-card garden-card folder-card filterable-item status-evergreen"
            data-tags={folderName}
            data-folder-item={folderName}
          >
            <div class="curator-tag" style="font-family: var(--font-mono); font-size: 11px; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; color: var(--text-color);">
              // {prefix}: <span class="badge badge-evergreen">FOLDER ({count})</span>
            </div>
            <div class="callout-body" style="font-size: 13px; line-height: 1.6; color: var(--text-secondary); margin-left: 16px;">
              <span class="note-link" style="font-family: var(--font-mono); font-weight: bold; font-size: 1.1rem; color: var(--text-color); text-decoration: underline;">[[{folderName}]]</span>
            </div>
          </BaseCard>
        );
      })}
      {allNotes.map(note => (
        <GardenCard note={note} lang={Astro.params.lang || 'en'} t={t} prefix={prefix} />
      ))}
    </div>
  </div>
</BaseLayout>
