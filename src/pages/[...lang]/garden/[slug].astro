---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

import { siteConfig } from '../../../site.config';

import KnowledgeGraph from '../../../components/KnowledgeGraph.astro';

export async function getStaticPaths() {
  const gardenEntries = await getCollection('garden', ({ data, id }) => {
    return data.draft !== true && !id.includes('/_');
  });
  return gardenEntries.map(entry => {
    const parts = entry.id.split('/');
    const isLang = siteConfig.locale.supported.includes(parts[0]);
    const langDir = isLang ? parts[0] : siteConfig.locale.default;
    const slugParts = isLang ? parts.slice(1) : parts;
    return {
      params: { 
        lang: langDir === siteConfig.locale.default ? undefined : langDir, 
        slug: slugParts.join('/').replace(/\.(md|mdx)$/, '') 
      },
      props: { entry }
    };
  });
}

import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const { entry } = Astro.props;
const { Content } = await render(entry);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
---
<BaseLayout>
  <div class="container">
    <div class="hero-grid" style="grid-template-columns: 2fr 1fr; gap: 32px;">
      <div class="article-card" style="background: var(--surface-color); border: var(--border-width) solid var(--border); padding: 32px; border-radius: 2px;">
        <div class="badge-row" style="display: flex; gap: 8px; margin-bottom: 24px;">
          <span class={`badge badge-${entry.data.status}`} style="font-family: var(--font-mono); font-size: 10px; font-weight: bold; padding: 2px 6px;">[{entry.data.status.toUpperCase()}]</span>
        </div>
        <h1 class="note-title" style="font-family: var(--font-mono); font-size: 22px; margin: 0 0 12px 0;">[[{entry.id}]]</h1>
        <div class="prose" style="font-size: 14px; line-height: 1.7; color: var(--text-secondary);">
          <Content />
        </div>
      </div>
      <div>
        <div class="sidebar-box" style="background: var(--surface-color); border: var(--border-width) solid var(--border); padding: 20px; border-radius: 2px;">
          <div style="font-family:var(--font-mono); font-size:12px; margin-bottom:12px;">
            {t('graph.title')}
          </div>
          <KnowledgeGraph localNodeId={entry.id} height="240px" />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>