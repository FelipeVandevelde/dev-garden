---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

import { siteConfig } from '../../../site.config';

import KnowledgeGraph from '../../../components/KnowledgeGraph.astro';
import BacklinksList from '../../../components/BacklinksList.astro';

import { generateGraphData } from '../../../utils/graph';

function buildBacklinksForEntry(entryId: string, graphData: { nodes?: any[]; links?: any[] }) {
  const nodeMap = new Map((graphData?.nodes || []).map((n: any) => [n.id, n]));
  const rawBacklinks = (graphData?.links || [])
    .filter((l: any) => l.target === entryId)
    .map((l: any) => nodeMap.get(l.source))
    .filter(Boolean);

  return rawBacklinks.map((bl: any) => {
    const blParts = bl.id.split('/');
    const blLang = blParts[0];
    const blRelativeSlug = blParts.slice(1).join('/').replace(/\.(md|mdx)$/i, '');
    const slugUrl = (blLang === siteConfig.locale.default ? '' : `/${blLang}`) + `/garden/${blRelativeSlug}`;
    return { title: bl.title, url: slugUrl };
  });
}

export async function getStaticPaths() {
  const gardenEntries = await getCollection('garden', ({ data, id }) => {
    const parts = id.split('/');
    if (!siteConfig.locale.supported.includes(parts[0]) || parts.length < 2) {
      return false;
    }
    return data.draft !== true && !id.includes('/_') && !parts[parts.length - 1]?.startsWith('_');
  });
  const graphData = await generateGraphData();
  const nodeMap = new Map((graphData?.nodes || []).map((n: any) => [n.id, n]));

  return gardenEntries.map(entry => {
    const parts = entry.id.split('/');
    const langDir = parts[0];
    const slugParts = parts.slice(1);
    const cleanSlug = slugParts.join('/').replace(/\.(md|mdx)$/i, '');

    const rawBacklinks = (graphData?.links || [])
      .filter((l: any) => l.target === entry.id)
      .map((l: any) => nodeMap.get(l.source))
      .filter(Boolean);

    const backlinks = rawBacklinks.map((bl: any) => {
      const blParts = bl.id.split('/');
      const blLang = blParts[0];
      const blRelativeSlug = blParts.slice(1).join('/').replace(/\.(md|mdx)$/i, '');
      const slugUrl = (blLang === siteConfig.locale.default ? '' : `/${blLang}`) + `/garden/${blRelativeSlug}`;
      return { title: bl.title, url: slugUrl };
    });

    return {
      params: { 
        lang: langDir === siteConfig.locale.default ? undefined : langDir, 
        slug: cleanSlug 
      },
      props: { entry, backlinks }
    };
  });
}

import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const { entry: propEntry, backlinks: propBacklinks } = Astro.props;
const entry = (import.meta.env.DEV && propEntry?.id)
  ? ((await getEntry('garden', propEntry.id)) ?? propEntry)
  : propEntry;
const backlinks = (import.meta.env.DEV && entry?.id)
  ? buildBacklinksForEntry(entry.id, await generateGraphData())
  : propBacklinks;
const { Content } = await render(entry);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
---
<BaseLayout>
  <div class="container">
    <div class="hero-grid" style="grid-template-columns: 2fr 1fr; gap: 32px;">
      <div class="article-card" style="background: var(--surface-color); border: var(--border-width) solid var(--border); padding: 32px; border-radius: 2px;">
        <div class="badge-row" style="display: flex; gap: 8px; margin-bottom: 24px;">
          <span class={`badge badge-${entry.data.status}`} style="font-family: var(--font-mono); font-size: 10px; font-weight: bold; padding: 2px 6px;" aria-hidden="true">[{entry.data.status.toUpperCase()}]</span><span class="sr-only"> [{entry.data.status.toUpperCase()}]</span>
        </div>
        <h1 class="note-title" style="font-family: var(--font-mono); font-size: 22px; margin: 0 0 12px 0;">[[{entry.id}]]</h1>
        <div class="prose" style="font-size: 14px; line-height: 1.7; color: var(--text-secondary);">
          <Content />
        </div>
      </div>
      <div>
        <div class="sidebar-box" style="background: var(--surface-color); border: var(--border-width) solid var(--border); padding: 20px; border-radius: 2px;">
          <div style="font-family:var(--font-mono); font-size:12px; margin-bottom:12px; text-transform: uppercase;">
            &gt; {t('graph.title') || 'Knowledge Graph'}
          </div>
          <KnowledgeGraph localNodeId={entry.id} height="240px" />
          <BacklinksList backlinks={backlinks} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
