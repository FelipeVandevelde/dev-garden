---
import { siteConfig } from '../../site.config';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return siteConfig.locale.supported.map(lang => ({
    params: { lang: lang === siteConfig.locale.default ? undefined : lang }
  }));
}
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';
import Constellation from '../../components/Constellation.astro';
import CommitStream from '../../components/CommitStream';

const lang = Astro.params.lang || siteConfig.locale.default;
const t = useTranslations(lang as 'en' | 'pt-br');
const langDir = lang === 'pt-br' ? 'pt-br' : 'en';
const profile = await getEntry('profile', langDir);
const gardenNotes = await getCollection('garden', ({ data, id }) => {
  if (!id.startsWith(langDir + '/')) return false;
  return data.draft !== true && !id.includes('/_');
});
---
<BaseLayout>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-bio">
        <h1 class="display-title">{profile?.data.name} &mdash; {profile?.data.title}</h1>
        <p class="bio-p">{profile?.data.bio}</p>
        <div class="system-status">
          {t('system.status')}
        </div>
      </div>
      <div class="metrics-card">
        <div class="metric-item"><span>{t('metrics.depth')}</span><span class="metric-val">5 YEARS</span></div>
        <div class="metric-item"><span>{t('metrics.production')}</span><span class="metric-val">1 DEPLOYED</span></div>
        <div class="metric-item"><span>{t('metrics.garden')}</span><span class="metric-val">{gardenNotes.length} {lang === 'pt-br' ? 'NOTAS' : 'NOTES'}</span></div>
        <div class="metric-item"><span>{t('metrics.lighthouse')}</span><span class="metric-val">95,5 / 100</span></div>
      </div>
    </div>

    <div class="section-header">{t('home.constellation')}</div>
    <Constellation />

    <div class="activity-stream">
      <div class="section-header">{t('home.stream')}</div>
      <CommitStream client:load />
    </div>
  </div>
</BaseLayout>
