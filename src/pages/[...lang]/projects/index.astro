---
import { siteConfig } from '../../../site.config';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  return siteConfig.locale.supported.map(lang => ({
    params: { lang: lang === siteConfig.locale.default ? undefined : lang }
  }));
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import FilterBar from '../../../components/FilterBar.astro';
import { getCollection } from 'astro:content';

const langDir = Astro.params.lang === 'pt-br' ? 'pt-br' : 'en';
const t = useTranslations((Astro.params.lang as 'en' | 'pt-br') || 'en');
const allProjects = await getCollection('projects', ({ data, id }) => id.startsWith(langDir + '/') && !id.includes('/_') && data.draft !== true);
const allTags = Array.from(new Set(allProjects.flatMap(p => p.data.tags)));
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      {t('projects.title')}
    </div>
    <FilterBar tags={allTags} emptyMessage={t('projects.empty') || '// No data found'} />
    <div class="project-grid" style="margin-top: 24px;">
      {allProjects.map(p => <ProjectCard id={p.id} project={p.data} prefix={langDir === 'pt-br' ? '/pt-br' : ''} />)}
    </div>
  </div>
</BaseLayout>