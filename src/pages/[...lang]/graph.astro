---
import { siteConfig } from '../../site.config';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return siteConfig.locale.supported.map(lang => ({
    params: { lang: lang === siteConfig.locale.default ? undefined : lang }
  }));
}
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import fs from 'node:fs';
import path from 'node:path';

interface GraphNode {
  id: string;
  title: string;
  status: string;
}

interface GraphLink {
  source: string;
  target: string;
}

interface AdjacencyRecord {
  node: GraphNode;
  in: GraphNode[];
  out: GraphNode[];
}

const lang = Astro.params.lang || siteConfig.locale.default;
const t = useTranslations(lang as 'en' | 'pt-br');
const graphPath = path.join(process.cwd(), 'public', 'graph-data.json');
let nodes: GraphNode[] = [];
let links: GraphLink[] = [];

if (fs.existsSync(graphPath)) {
  const data = JSON.parse(fs.readFileSync(graphPath, 'utf8'));
  nodes = data.nodes.filter((n: any) => n.id.startsWith(lang + "/"));
  links = data.links.filter((l: any) => l.source.startsWith(lang + "/") && l.target.startsWith(lang + "/"));
}

const adjacency: Record<string, AdjacencyRecord> = {};
nodes.forEach(n => {
  adjacency[n.id] = { node: n, in: [], out: [] };
});
links.forEach(l => {
  if (adjacency[l.source] && adjacency[l.target]) {
    adjacency[l.source].out.push(adjacency[l.target].node);
    adjacency[l.target].in.push(adjacency[l.source].node);
  }
});
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      {t('graph.title')}
    </div>

    <KnowledgeGraph />

    <nav class="graph-fallback" aria-label="Graph Fallback Navigation">
      {nodes.map(n => (
        <div class="node-list-item" style="margin-bottom: 2rem; border-bottom: var(--border-width) dotted var(--text-color); padding-bottom: 1rem;">
          <h3><a href={`${lang === "pt-br" ? "/pt-br" : ""}/garden/${n.id.split("/").slice(1).join("/")}`}>{n.title}</a> <span class={`badge badge-${n.status}`}>[{n.status.toUpperCase()}]</span></h3>
          
          <div style="margin-top: 1rem;">
            <strong>{t('graph.mentions')}</strong>
            {adjacency[n.id].out.length > 0 ? (
              <ul style="list-style: circle; margin-left: 2rem;">
                {adjacency[n.id].out.map(outNode => (
                  <li><a href={`${lang === "pt-br" ? "/pt-br" : ""}/garden/${outNode.id.split("/").slice(1).join("/")}`}>{outNode.title}</a></li>
                ))}
              </ul>
            ) : <span style="opacity: 0.6; margin-left: 0.5rem;">{t('graph.none')}</span>}
          </div>

          <div style="margin-top: 1rem;">
            <strong>{t('graph.referenced')}</strong>
            {adjacency[n.id].in.length > 0 ? (
              <ul style="list-style: square; margin-left: 2rem;">
                {adjacency[n.id].in.map(inNode => (
                  <li><a href={`${lang === "pt-br" ? "/pt-br" : ""}/garden/${inNode.id.split("/").slice(1).join("/")}`}>{inNode.title}</a></li>
                ))}
              </ul>
            ) : <span style="opacity: 0.6; margin-left: 0.5rem;">{t('graph.none')}</span>}
          </div>
        </div>
      ))}
    </nav>
  </div>


</BaseLayout>