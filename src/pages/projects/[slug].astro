---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map(p => ({
    params: { slug: p.id },
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error("Slug is required");
const projectEntry = await getEntry('projects', slug);
if (!projectEntry) throw new Error(`Project ${slug} not found`);
const project = projectEntry.data;
---
<BaseLayout>
  <article class="project-case-study">
    <header style="border-bottom: 4px solid var(--text-color); padding-bottom: 2rem; margin-bottom: 2rem;">
      <h1 style="font-size: 3rem; text-transform: uppercase; margin-bottom: 0;">{project.title}</h1>
      <p class="description" style="font-size: 1.25rem;">{project.description}</p>
      <div class="links" style="display: flex; gap: 1rem; margin-top: 1rem; font-family: monospace;">
        {project.liveUrl && <a href={project.liveUrl} target="_blank">Live URL ↗</a>}
        {project.githubUrl && <a href={project.githubUrl} target="_blank">GitHub ↗</a>}
      </div>
    </header>
    
    <section class="curator-notes">
      <div class="section-header" style="margin-top: 2rem; margin-bottom: 1rem;">&gt; CURATOR NOTES (MONOCHROME)</div>
      
      {project.curatorNotes?.context && (
        <div class="curator-box" style="background: var(--surface-color); border: var(--border-width) solid var(--border); border-left: 3px solid var(--text-color); border-radius: 2px; padding: 18px; margin-top: 16px;">
          <div class="curator-tag" style="font-family: var(--font-mono); font-size: 11px; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; color: var(--text-color);">
            // [CONTEXT] Context [SOLID_BORDER]
          </div>
          <div class="callout-body" style="font-size: 13px; line-height: 1.6; color: var(--text-secondary);">
            {project.curatorNotes.context}
          </div>
        </div>
      )}
      
      {project.curatorNotes?.architecture && (
        <div class="curator-box" style="background: var(--surface-color); border: var(--border-width) solid var(--border); border-left: 3px double var(--text-muted); border-radius: 2px; padding: 18px; margin-top: 16px;">
          <div class="curator-tag" style="font-family: var(--font-mono); font-size: 11px; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; color: var(--text-color);">
            // [SYS_ARCH] Architecture & Choices [DOUBLE_BORDER]
          </div>
          <div class="callout-body" style="font-size: 13px; line-height: 1.6; color: var(--text-secondary);">
            {project.curatorNotes.architecture}
          </div>
        </div>
      )}
      
      {project.curatorNotes?.tradeOffs && (
        <div class="curator-box" style="background: var(--surface-color); border: var(--border-width) solid var(--border); border-left: 3px dashed var(--border); border-radius: 2px; padding: 18px; margin-top: 16px;">
          <div class="curator-tag" style="font-family: var(--font-mono); font-size: 11px; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; color: var(--text-color);">
            // [TRADE_OFF] Key Trade-offs [DASHED_BORDER]
          </div>
          <div class="callout-body" style="font-size: 13px; line-height: 1.6; color: var(--text-secondary);">
            {project.curatorNotes.tradeOffs}
          </div>
        </div>
      )}
      
      {project.curatorNotes?.lessonsLearned && (
        <div class="curator-box" style="background: var(--surface-color); border: var(--border-width) solid var(--border); border-left: 3px dotted var(--text-muted); border-radius: 2px; padding: 18px; margin-top: 16px;">
          <div class="curator-tag" style="font-family: var(--font-mono); font-size: 11px; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; color: var(--text-color);">
            // [LESSONS] Lessons Learned [DOTTED_BORDER]
          </div>
          <div class="callout-body" style="font-size: 13px; line-height: 1.6; color: var(--text-secondary);">
            {project.curatorNotes.lessonsLearned}
          </div>
        </div>
      )}
    </section>
  </article>
</BaseLayout>