---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import GardenCard from '../../components/GardenCard.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('garden', ({ data, id }) => {
  return data.draft !== true && !id.startsWith('_');
});

const allStatuses = Array.from(new Set(allNotes.map(n => n.data.status)));
---
<BaseLayout>
  <div class="container">
    <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-color); margin-bottom: 20px;">
      &gt; DIGITAL GARDEN // SYNTHESIZED NOTES &amp; ARCHITECTURE PATTERNS
    </div>
    <FilterBar tags={allStatuses} />

    <div class="garden-list" style="margin-top: 2rem;">
      {allNotes.map(note => (
        <GardenCard note={note} />
      ))}
    </div>
  </div>
</BaseLayout>