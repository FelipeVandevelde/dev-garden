---

---
<div id="hover-popover" class="hover-popover" aria-hidden="true">
  <div class="popover-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; border-bottom: var(--border-width) dashed var(--border); padding-bottom: 0.5rem;">
    <strong id="popover-title" style="font-family: monospace;"></strong>
    <div>
      <span id="popover-badge" class="badge" aria-hidden="true"></span>
      <span id="popover-badge-sr" class="sr-only"></span>
    </div>
  </div>
  <p id="popover-excerpt" style="font-size: 0.9rem; margin: 0;"></p>
</div>

<script is:inline>
  (function() {
    let hoverTimer;
    let leaveTimer;
    let hideAnimTimer;
    let activeTarget = null;
    const popover = document.getElementById('hover-popover');
    const titleEl = document.getElementById('popover-title');
    const badgeEl = document.getElementById('popover-badge');
    const badgeSrEl = document.getElementById('popover-badge-sr');
    const excerptEl = document.getElementById('popover-excerpt');

    if (!popover) return;

    const showPopover = (target) => {
      clearTimeout(leaveTimer);
      clearTimeout(hideAnimTimer);
      activeTarget = target;
      hoverTimer = setTimeout(() => {
        if (activeTarget !== target) return;
        
        const title = target.getAttribute('data-preview-title') || 'Unknown';
        const status = target.getAttribute('data-preview-status') || '';
        const excerpt = target.getAttribute('data-preview-excerpt') || '';
        
        titleEl.textContent = title;
        badgeEl.textContent = status ? `[${status.toUpperCase()}]` : '';
        badgeEl.className = status ? `badge badge-${status}` : 'badge';
        badgeSrEl.textContent = status ? ` [${status.toUpperCase()}]` : '';
        excerptEl.textContent = excerpt;

        popover.style.display = 'block';
        
        const rect = target.getBoundingClientRect();
        const popoverRect = popover.getBoundingClientRect();
        
        let top = rect.bottom + window.scrollY + 5;
        let left = rect.left + window.scrollX;
        
        if (left + popoverRect.width > window.innerWidth) {
          left = Math.max(0, window.innerWidth - popoverRect.width - 20);
        }
        
        if (rect.bottom + popoverRect.height + 20 > window.innerHeight) {
          top = rect.top + window.scrollY - popoverRect.height - 5;
        }
        
        popover.style.top = top + 'px';
        popover.style.left = left + 'px';
        popover.setAttribute('aria-hidden', 'false');
        popover.style.opacity = '1';
      }, 200);
    };

    const hidePopover = (target) => {
      clearTimeout(hoverTimer);
      if (activeTarget === target) activeTarget = null;
      leaveTimer = setTimeout(() => {
        if (!activeTarget) {
          popover.style.opacity = '0';
          popover.setAttribute('aria-hidden', 'true');
          hideAnimTimer = setTimeout(() => {
            if (popover.style.opacity === '0') {
              popover.style.display = 'none';
            }
          }, 200);
        }
      }, 150);
    };

    document.addEventListener('mouseover', (e) => {
      const target = e.target.closest('a.wikilink');
      if (target) showPopover(target);
    });
    document.addEventListener('focusin', (e) => {
      const target = e.target.closest('a.wikilink');
      if (target) showPopover(target);
    });

    document.addEventListener('mouseout', (e) => {
      const target = e.target.closest('a.wikilink');
      if (target) hidePopover(target);
    });
    document.addEventListener('focusout', (e) => {
      const target = e.target.closest('a.wikilink');
      if (target) hidePopover(target);
    });
  })();
</script>
