---
import { nodes, links } from '../data/skills';
---

<div class="constellation-frame">
  <svg class="constellation-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none;">
    {/* Draw Links */}
    {links.map(link => {
      const sourceNode = nodes.find(n => n.id === link.source);
      const targetNode = nodes.find(n => n.id === link.target);
      if (!sourceNode || !targetNode) return null;

      return (
        <line
          x1={`${sourceNode.x}%`}
          y1={`${sourceNode.y}%`}
          x2={`${targetNode.x}%`}
          y2={`${targetNode.y}%`}
          stroke="var(--border)"
          class="constellation-link"
          data-source={link.source}
          data-target={link.target}
          style="stroke-width: var(--border-width); transition: all 0.3s ease"
        />
      );
    })}
  </svg>
  
  <div class="nodes-layer" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2;">
    {/* Draw Nodes */}
    {nodes.map(node => (
      <button 
        class="node constellation-node"
        data-id={node.id}
        style={`position: absolute; left: ${node.x}%; top: ${node.y}%; transform: translate(-50%, -50%);`}
      >
        <span class="node-dot"></span>{node.label}
      </button>
    ))}
  </div>
  
  <div class="constellation-status">
    [Active Filter] -&gt; <span id="constellation-filter-text">Select a node to filter content</span>
  </div>
</div>

<script is:inline>
  (function() {
    const nodes = document.querySelectorAll('.constellation-node');
    const links = document.querySelectorAll('.constellation-link');
    let activeNode = null;
    const filterText = document.getElementById('constellation-filter-text');

    function resetGraph() {
      activeNode = null;
      nodes.forEach(n => {
        n.classList.remove('selected');
        n.style.opacity = '1';
        n.setAttribute('aria-pressed', 'false');
      });
      links.forEach(l => {
        l.style.opacity = '1';
        l.style.strokeWidth = 'var(--border-width)';
      });
      if (filterText) filterText.innerHTML = 'Select a node to filter content';
    }

    function highlightNode(id, label) {
      if (activeNode === id) {
        resetGraph();
        return;
      }
      activeNode = id;

      const connectedNodeIds = new Set();
      links.forEach(l => {
        const source = l.getAttribute('data-source');
        const target = l.getAttribute('data-target');
        if (source === id || target === id) {
          l.style.opacity = '1';
          l.style.strokeWidth = 'calc(var(--border-width) * 2)';
          connectedNodeIds.add(source);
          connectedNodeIds.add(target);
        } else {
          l.style.opacity = '0.15';
          l.style.strokeWidth = 'var(--border-width)';
        }
      });

      nodes.forEach(n => {
        const nid = n.getAttribute('data-id');
        
        if (nid === id) {
          n.classList.add('selected');
          n.style.opacity = '1';
          n.setAttribute('aria-pressed', 'true');
        } else if (connectedNodeIds.has(nid)) {
          n.classList.remove('selected');
          n.style.opacity = '1';
          n.setAttribute('aria-pressed', 'false');
        } else {
          n.classList.remove('selected');
          n.style.opacity = '0.35';
          n.setAttribute('aria-pressed', 'false');
        }
      });
      
      if (filterText) {
        filterText.innerHTML = 'Viewing details for <b></b>';
        filterText.querySelector('b').textContent = label;
      }
    }

    nodes.forEach(n => {
      n.addEventListener('click', () => {
        highlightNode(n.getAttribute('data-id'), n.innerText.trim());
      });
      n.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          highlightNode(n.getAttribute('data-id'), n.innerText.trim());
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeNode) {
        resetGraph();
      }
    });
  })();
</script>