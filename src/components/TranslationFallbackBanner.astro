---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="fallback-banner" style="border: var(--border-width) solid var(--text-color); padding: 1rem; margin-bottom: 1rem; text-align: center;">
  <strong>{t('banner.missing')}</strong>
</div>