---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---
<dialog id="command-palette" class="command-palette" role="dialog" aria-label="Command Palette">
  <div class="palette-container">
    <div class="palette-header" style="display:flex; align-items:center;">
      <span class="prompt" style="padding-left:1rem; font-weight:bold;">&gt;_</span>
      <input type="text" id="palette-input" role="combobox" aria-autocomplete="list" aria-controls="palette-list" aria-expanded="true" placeholder={t('command.placeholder') || "Search or type a command... (Cmd+K)"} autocomplete="off" spellcheck="false" style="flex:1;" />
      <span class="esc-tag" style="margin-right:1rem; font-size:10px; border:1px solid var(--text-muted); padding:2px 6px; border-radius:2px; color:var(--text-muted);">ESC</span>
    </div>
    <div class="palette-results" id="palette-results">
      <ul id="palette-list" role="listbox">
        <!-- Default Actions rendered dynamically -->
      </ul>
    </div>
    <div class="modal-footer" style="border-top: var(--border-width) solid var(--border); padding: 10px 16px; display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); font-family: monospace;">
      <span>Use ↑ / ↓ to navigate</span>
      <span>↵ to select</span>
      <span>ESC to dismiss</span>
    </div>
  </div>
</dialog>
<template id="palette-default-actions">
  <div class="results-group" style="padding: 12px 16px 4px 16px; font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; font-family: monospace;">THEME MODES & COMMANDS</div>
  <li class="palette-item action-item" data-action="theme" tabindex="-1" role="option" style="justify-content: space-between;">
    <span>Cycle Theme: [Dark ➔ Light ➔ HC Dark ➔ HC Light]</span>
    <span class="shortcut-badge" style="font-size: 10px; border: 1px solid var(--text-muted); padding: 1px 5px; border-radius: 2px;">t t</span>
  </li>
  <li class="palette-item action-item" data-action="graph" tabindex="-1" role="option" style="justify-content: space-between;">
    <span>Open Knowledge Graph</span>
    <span class="shortcut-badge" style="font-size: 10px; border: 1px solid var(--text-muted); padding: 1px 5px; border-radius: 2px;">g g</span>
  </li>
</template>

<style>
  .command-palette {
    padding: 0;
    border: var(--border-width) solid var(--text-color);
    background: var(--bg-color);
    color: var(--text-color);
    width: 90%;
    max-width: 640px;
    border-radius: 4px;
    top: 15vh;
    margin: 0 auto;
  }
  .command-palette::backdrop { background: transparent; }
  .palette-header input {
    width: 100%; padding: 1rem; font-size: 1.2rem; border: none;
    border-bottom: var(--border-width) solid var(--text-color);
    background: transparent; color: var(--text-color);
    font-family: monospace; outline: none;
  }
  .palette-results { max-height: 400px; overflow-y: auto; }
  #palette-list { list-style: none; margin: 0; padding: 0; }
  .palette-item {
    padding: 0.75rem 1rem; cursor: pointer; display: flex;
    align-items: center; gap: 0.5rem; border-left: 2px solid transparent;
  }
  .palette-item:hover, .palette-item.selected {
    background: var(--focus-color); color: var(--bg-color);
    border-left: 2px solid var(--focus-color);
  }
  .palette-item .icon { opacity: 0.7; }
</style>

<script is:inline define:vars={{ baseUrl, noResultsText: "No results found for", errorText: "Search failed." }}>
  (function() {
    const dialog = document.getElementById('command-palette');
    const input = document.getElementById('palette-input');
    const list = document.getElementById('palette-list');
    const defaultActionsHtml = document.getElementById('palette-default-actions').innerHTML;
    
    let pagefind = null;
    let selectedIndex = 0;
    let searchCounter = 0;
    
    function resetToDefault() {
      list.innerHTML = defaultActionsHtml;
      selectedIndex = 0;
      updateSelection();
    }

    function escapeHtml(unsafe) {
      if (!unsafe) return '';
      return unsafe.toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else {
          dialog.showModal();
          input.value = '';
          resetToDefault();
          input.focus();
        }
      }
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    function updateSelection() {
      const items = list.querySelectorAll('.palette-item');
      items.forEach((item, i) => {
        if (i === selectedIndex) {
          item.classList.add('selected'); 
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('selected'); 
          item.setAttribute('aria-selected', 'false');
        }
      });
    }

    function triggerAction(item) {
      if (!item) return;
      if (item.classList.contains('action-item')) {
        const action = item.getAttribute('data-action');
        if (action === 'theme') {
          const current = document.documentElement.getAttribute('data-theme') || 'Dark';
          const themes = ["Light", "Dark", "HC-Light", "HC-Dark"];
          const next = themes[(themes.indexOf(current) + 1) % themes.length];
          document.documentElement.setAttribute('data-theme', next);
          try { window.localStorage.setItem('theme', next); } catch(err) { window.__fallbackStorage = window.__fallbackStorage || {}; window.__fallbackStorage['theme'] = next; }
        } else if (action === 'graph') {
          const lang = document.documentElement.lang;
          window.location.href = lang === 'pt-br' ? '/pt-br/graph' : '/graph';
        }
        dialog.close();
      } else {
        const href = item.getAttribute('data-href');
        if (href) {
          window.location.href = href;
        }
      }
    }

    input.addEventListener('keydown', (e) => {
      const items = list.querySelectorAll('.palette-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const idx = selectedIndex >= 0 ? selectedIndex : 0;
        if (idx >= 0 && idx < items.length) {
          triggerAction(items[idx]);
        }
      }
    });

    list.addEventListener('click', (e) => {
      const item = e.target.closest('.palette-item');
      if (item) triggerAction(item);
    });

    let debounceTimer;
    input.addEventListener('input', async (e) => {
      const query = e.target.value.trim();
      selectedIndex = 0;
      
      if (!query) {
        resetToDefault();
        return;
      }

      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const currentSearch = ++searchCounter;
        
        if (!pagefind) {
          try {
            pagefind = await import(baseUrl + '/pagefind/pagefind.js');
          } catch(err) {
            console.error("Pagefind failed to load:", err);
            if (currentSearch === searchCounter) {
              list.innerHTML = `<li class="palette-item" style="opacity:0.5" role="option">Search index not found. Run build first.</li>`;
            }
            return;
          }
        }

        let search;
        try {
          search = await pagefind.search(query);
        } catch(err) {
          if (currentSearch === searchCounter) {
            list.innerHTML = `<li class="palette-item" style="opacity:0.5; color:red" role="option">${escapeHtml(errorText)}</li>`;
          }
          return;
        }
        
        if (currentSearch !== searchCounter) return;
        
        if (!search || !search.results || search.results.length === 0) {
          list.innerHTML = `<li class="palette-item" style="opacity:0.5" role="option">${escapeHtml(noResultsText)} "${escapeHtml(query)}"</li>`;
        } else {
          const topResults = await Promise.all(search.results.slice(0, 5).map(r => r.data().catch(() => null)));
          if (currentSearch !== searchCounter) return;
          
          const validResults = topResults.filter(Boolean);
          
          const projects = validResults.filter(r => r.url.includes('/projects/'));
          const garden = validResults.filter(r => r.url.includes('/garden/'));
          const others = validResults.filter(r => !r.url.includes('/projects/') && !r.url.includes('/garden/'));

          let html = '';
          if (projects.length > 0) {
            html += `<div class="results-group" style="padding: 12px 16px 4px 16px; font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; font-family: monospace;">PROJECT CASE STUDIES (${projects.length})</div>`;
            html += projects.map(r => `
              <li class="palette-item result-item" data-href="${escapeHtml(r.url)}" role="option" style="justify-content: space-between;">
                <span><b>${escapeHtml(r.meta?.title || r.url)}</b></span>
                <span class="shortcut-badge" style="font-size: 10px; border: 1px solid var(--text-muted); padding: 1px 5px; border-radius: 2px; color: inherit; border-color: inherit;">Jump ↵</span>
              </li>
            `).join('');
          }
          if (garden.length > 0) {
            html += `<div class="results-group" style="padding: 12px 16px 4px 16px; font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; font-family: monospace;">DIGITAL GARDEN SYNTHESES (${garden.length})</div>`;
            html += garden.map(r => `
              <li class="palette-item result-item" data-href="${escapeHtml(r.url)}" role="option" style="justify-content: space-between;">
                <span>[[${escapeHtml(r.meta?.title || r.url)}]]</span>
                <span class="shortcut-badge" style="font-size: 10px; border: 1px solid var(--text-muted); padding: 1px 5px; border-radius: 2px; color: inherit; border-color: inherit;">Jump ↵</span>
              </li>
            `).join('');
          }
          if (others.length > 0) {
            html += `<div class="results-group" style="padding: 12px 16px 4px 16px; font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; font-family: monospace;">OTHER RESULTS (${others.length})</div>`;
            html += others.map(r => `
              <li class="palette-item result-item" data-href="${escapeHtml(r.url)}" role="option" style="justify-content: space-between;">
                <span>${escapeHtml(r.meta?.title || r.url)}</span>
                <span class="shortcut-badge" style="font-size: 10px; border: 1px solid var(--text-muted); padding: 1px 5px; border-radius: 2px; color: inherit; border-color: inherit;">Jump ↵</span>
              </li>
            `).join('');
          }
          list.innerHTML = html;
        }
        selectedIndex = 0;
        updateSelection();
      }, 200);
    });
  })();
</script>