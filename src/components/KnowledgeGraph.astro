---
interface Props {
  localNodeId?: string;
  height?: string;
}

const { localNodeId, height } = Astro.props;
---

<div id="graph-container" class={`graph-container ${localNodeId ? 'local-graph' : ''}`} style={`position: relative; overflow: hidden; touch-action: none; ${height ? 'height: ' + height + ';' : ''}`} data-local-node-id={localNodeId}>
  <p style="text-align: center; padding: 2rem; border: var(--border-width) dashed var(--text-color); font-family: var(--font-mono); font-size: 12px;">Initializing graph...</p>
</div>

<script>
  let graphInstance: any = null;
  let observer: MutationObserver | null = null;
  let dataCache: any = null;

  async function initGraph() {
    const container = document.getElementById('graph-container');
    if (!container) return;

    if (window.innerWidth < 768) {
      container.innerHTML = '';
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      if (graphInstance) {
        if (typeof graphInstance._destructor === 'function') {
          graphInstance._destructor();
        }
        graphInstance = null;
      }
      return;
    }

    if (graphInstance && typeof graphInstance._destructor === 'function') {
      graphInstance._destructor();
      graphInstance = null;
    }

    try {
      if (!dataCache) {
        const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, '');
        const res = await fetch(baseUrl + '/graph-data.json');
        if (!res.ok) throw new Error('Failed to fetch graph data');
        dataCache = await res.json();
      }
      const data = dataCache;
      const { default: ForceGraph } = await import('force-graph');
      
      const width = container.clientWidth;
      const height = container.clientHeight || 600;
      
      container.innerHTML = '';

      const getThemeColors = () => {
        const style = getComputedStyle(document.documentElement);
        return {
          text: style.getPropertyValue('--text-color').trim() || '#000',
          bg: style.getPropertyValue('--bg-color').trim() || '#fff',
          focus: style.getPropertyValue('--focus-color').trim() || style.getPropertyValue('--text-color').trim() || '#000',
        };
      };

      let colors = getThemeColors();

      const lang = document.documentElement.lang || 'en';
      let graphNodes = (data?.nodes || []).filter((n: any) => typeof n?.id === 'string' && n.id.startsWith(lang + "/"));
      let graphLinks = (data?.links || []).filter((l: any) => typeof l?.source === 'string' && typeof l?.target === 'string' && l.source.startsWith(lang + "/") && l.target.startsWith(lang + "/"));

      const localNodeId = container.getAttribute('data-local-node-id');

      if (localNodeId) {
        const connectedNodeIds = new Set<string>();
        connectedNodeIds.add(localNodeId);

        graphLinks.forEach((l: any) => {
          if (l.source === localNodeId) {
            connectedNodeIds.add(l.target);
          } else if (l.target === localNodeId) {
            connectedNodeIds.add(l.source);
          }
        });

        graphNodes = graphNodes.filter((n: any) => connectedNodeIds.has(n.id));
        graphLinks = graphLinks.filter((l: any) => connectedNodeIds.has(l.source) && connectedNodeIds.has(l.target));
      }

      const degree: Record<string, number> = {};
      graphNodes.forEach((n: any) => degree[n.id] = 0);
      graphLinks.forEach((l: any) => {
        if (degree[l.source] !== undefined) degree[l.source]++;
        if (degree[l.target] !== undefined) degree[l.target]++;
      });

      const nodes = graphNodes.map((d: any) => Object.assign({}, d));
      const links = graphLinks.map((d: any) => Object.assign({}, d));

      graphInstance = (ForceGraph as any)()(container)
        .width(width)
        .height(height)
        .backgroundColor(colors.bg)
        .nodeRelSize(5)
        .nodeVal((node: any) => (degree[node.id] || 0) * 2 + 5)
        .nodeColor((node: any) => node.id === localNodeId ? colors.focus : colors.text)
        .linkColor(() => colors.text)
        .linkWidth(1)
        .linkOpacity(0.2)
        .onNodeClick((node: any) => {
          const langPrefix = document.documentElement.lang === 'pt-br' ? '/pt-br' : '';
          window.location.href = `${langPrefix}/garden/${node.id.split("/").slice(1).join("/")}`;
        })
        .nodeCanvasObject((node: any, ctx: CanvasRenderingContext2D) => {
          const r = 5 + (degree[node.id] || 0) * 2;
          ctx.save();
          ctx.beginPath();
          ctx.arc(node.x, node.y, r, 0, 2 * Math.PI);
          ctx.fillStyle = colors.bg;
          ctx.fill();
          ctx.strokeStyle = node.id === localNodeId ? colors.focus : colors.text;
          ctx.lineWidth = node.id === localNodeId ? 3 : 2;
          ctx.stroke();

          ctx.fillStyle = colors.text;
          ctx.font = node.id === localNodeId ? "bold 14px monospace" : "12px monospace";
          ctx.fillText(node.title || '', node.x + r + 6, node.y + 4);
          ctx.restore();
        })
        .graphData({ nodes, links });

      graphInstance.d3Force('charge').strength(-400);

      if (observer) {
        observer.disconnect();
      }
      
      observer = new MutationObserver(() => {
        colors = getThemeColors();
        graphInstance
          .backgroundColor(colors.bg)
          .nodeColor((node: any) => node.id === localNodeId ? colors.focus : colors.text)
          .linkColor(() => colors.text);
      });
      
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      observer.observe(document.body, { attributes: true, attributeFilter: ['class', 'data-theme'] });

    } catch(e) {
      console.error("Graph init failed:", e);
    }
  }

  let timeout: any;
  window.addEventListener('resize', () => {
    clearTimeout(timeout);
    timeout = setTimeout(() => {
      const container = document.getElementById('graph-container');
      if (window.innerWidth < 768) {
        if (container) container.innerHTML = '';
        if (graphInstance) {
          if (typeof graphInstance._destructor === 'function') {
            graphInstance._destructor();
          }
          graphInstance = null;
        }
        return;
      }
      if (graphInstance && container) {
        graphInstance.width(container.clientWidth);
        graphInstance.height(container.clientHeight || 600);
      } else {
        initGraph();
      }
    }, 250);
  });

  initGraph();
</script>
