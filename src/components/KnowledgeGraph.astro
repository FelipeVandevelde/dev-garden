---
interface Props {
  localNodeId?: string;
  height?: string;
}

const { localNodeId, height } = Astro.props;
---

<div id="graph-container" class={`graph-container ${localNodeId ? 'local-graph' : ''}`} style={`position: relative; overflow: hidden; touch-action: none; ${height ? 'height: ' + height + ';' : ''}`} data-local-node-id={localNodeId}>
  <p style="text-align: center; padding: 2rem; border: var(--border-width) dashed var(--text-color); font-family: var(--font-mono); font-size: 12px;">Initializing graph...</p>
</div>

<script>
  import * as d3 from 'd3';

  let simulation: any = null;

  async function initGraph() {
    const container = document.getElementById('graph-container');
    if (!container) return;

    if (window.innerWidth < 768) {
      container.innerHTML = '';
      return;
    }

    try {
      const res = await fetch('/graph-data.json');
      const data = await res.json();
      
      const width = container.clientWidth;
      const height = container.clientHeight;
      
      container.innerHTML = '';
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      container.appendChild(canvas);
      
      const context = canvas.getContext('2d');
      if (!context) return;

      const style = getComputedStyle(document.body);
      const textColor = style.getPropertyValue('--text-color').trim() || '#000';
      const bgColor = style.getPropertyValue('--bg-color').trim() || '#fff';
      const focusColor = style.getPropertyValue('--focus-color').trim() || textColor;

      const lang = document.documentElement.lang || 'en';
      let graphNodes = data.nodes.filter((n: any) => n.id.startsWith(lang + "/"));
      let graphLinks = data.links.filter((l: any) => l.source.startsWith(lang + "/") && l.target.startsWith(lang + "/"));

      const localNodeId = container.getAttribute('data-local-node-id');

      if (localNodeId) {
        const connectedNodeIds = new Set<string>();
        connectedNodeIds.add(localNodeId);

        graphLinks.forEach((l: any) => {
          if (l.source === localNodeId) {
            connectedNodeIds.add(l.target);
          } else if (l.target === localNodeId) {
            connectedNodeIds.add(l.source);
          }
        });

        graphNodes = graphNodes.filter((n: any) => connectedNodeIds.has(n.id));
        graphLinks = graphLinks.filter((l: any) => connectedNodeIds.has(l.source) && connectedNodeIds.has(l.target));
      }

      const degree: Record<string, number> = {};
      graphNodes.forEach((n: any) => degree[n.id] = 0);
      graphLinks.forEach((l: any) => {
        if (degree[l.source] !== undefined) degree[l.source]++;
        if (degree[l.target] !== undefined) degree[l.target]++;
      });

      const nodes = graphNodes.map((d: any) => Object.create(d));
      const links = graphLinks.map((d: any) => Object.create(d));

      simulation = d3.forceSimulation(nodes)
          .force("link", d3.forceLink(links).id((d: any) => d.id).distance(150))
          .force("charge", d3.forceManyBody().strength(-400))
          .force("center", d3.forceCenter(width / 2, height / 2));

      let currentTransform = d3.zoomIdentity;

      function ticked() {
        if (!context) return;
        context.save();
        context.clearRect(0, 0, width, height);
        context.translate(currentTransform.x, currentTransform.y);
        context.scale(currentTransform.k, currentTransform.k);

        context.beginPath();
        links.forEach((d: any) => {
          context.moveTo(d.source.x, d.source.y);
          context.lineTo(d.target.x, d.target.y);
        });
        context.strokeStyle = textColor;
        context.globalAlpha = 0.2;
        context.stroke();
        context.globalAlpha = 1.0;

        nodes.forEach((d: any) => {
          context.beginPath();
          const r = 5 + (degree[d.id] || 0) * 2;
          d.r = r;
          context.moveTo(d.x + r, d.y);
          context.arc(d.x, d.y, r, 0, 2 * Math.PI);
          context.fillStyle = bgColor;
          context.fill();
          context.strokeStyle = d.id === localNodeId ? focusColor : textColor;
          context.lineWidth = d.id === localNodeId ? 3 : 2;
          context.stroke();

          context.fillStyle = textColor;
          context.font = d.id === localNodeId ? "bold 14px monospace" : "12px monospace";
          context.fillText(d.title, d.x + r + 6, d.y + 4);
        });
        
        context.restore();
      }

      simulation.on("tick", ticked);

      d3.select(canvas).call(d3.zoom<HTMLCanvasElement, unknown>()
          .scaleExtent([0.1, 4])
          .on("zoom", (e: any) => {
             currentTransform = e.transform;
             ticked();
          }));

      canvas.addEventListener('click', (e) => {
        const rect = canvas.getBoundingClientRect();
        const mx = (e.clientX - rect.left - currentTransform.x) / currentTransform.k;
        const my = (e.clientY - rect.top - currentTransform.y) / currentTransform.k;
        
        let closest: any = null;
        let minDist = Infinity;
        nodes.forEach((d: any) => {
          const dx = mx - d.x;
          const dy = my - d.y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < d.r + 5 && dist < minDist) {
            minDist = dist;
            closest = d;
          }
        });

        if (closest) {
          const langPrefix = document.documentElement.lang === 'pt-br' ? '/pt-br' : '';
          window.location.href = `${langPrefix}/garden/${closest.id.split("/").slice(1).join("/")}`;
        }
      });
      
      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const mx = (e.clientX - rect.left - currentTransform.x) / currentTransform.k;
        const my = (e.clientY - rect.top - currentTransform.y) / currentTransform.k;
        
        let found = false;
        nodes.forEach((d: any) => {
          const dx = mx - d.x;
          const dy = my - d.y;
          if (Math.sqrt(dx*dx + dy*dy) < d.r + 5) found = true;
        });
        canvas.style.cursor = found ? 'pointer' : 'grab';
      });

    } catch(e) {
      console.error("Graph init failed:", e);
    }
  }

  let timeout: any;
  window.addEventListener('resize', () => {
    clearTimeout(timeout);
    timeout = setTimeout(initGraph, 250);
  });

  initGraph();
</script>
