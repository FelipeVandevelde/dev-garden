---
import { siteConfig } from '../site.config';
import { getLangFromUrl, useTranslations, getRouteWithLang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const enUrl = getRouteWithLang(Astro.url, 'en');
const ptUrl = getRouteWithLang(Astro.url, 'pt-br');
---
<header class="global-header">
  <nav class="nav-links">
    {siteConfig.nav.map((item) => {
      let href = item.href;
      if (lang !== 'en') {
        href = `/${lang}${href === '/' ? '' : href}`;
      }
      return <a href={href} class="nav-link">{t('nav.' + item.label.toLowerCase() as any) || item.label}</a>
    })}
  </nav>
  <div class="toggles">
    <div class="lang-toggle">
      <a href={ptUrl} style={lang === 'pt-br' ? 'font-weight: bold; text-decoration: underline;' : ''}>PT</a> | 
      <a href={enUrl} style={lang === 'en' ? 'font-weight: bold; text-decoration: underline;' : ''}>EN</a>
    </div>
    <div class="theme-toggle" id="theme-toggle-ui">
      <span>DARK</span> | <span>LIGHT</span> | <span>HC-DARK</span> | <span>HC-LIGHT</span>
    </div>
  </div>
</header>
