---
import { getLangFromUrl, useTranslations, getRouteWithLang } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const enUrl = getRouteWithLang(Astro.url, 'en');
const ptUrl = getRouteWithLang(Astro.url, 'pt-br');
---
<header class="terminal-nav">
  <div class="nav-brand">~/felipe-dev [MONOCHROME_TERMINAL]</div>
  <nav class="nav-links">
    {[
      { label: t('nav.home'), href: '/' },
      { label: t('nav.projects'), href: `/projects` },
      { label: t('nav.digital_garden'), href: `/garden` },
      { label: t('nav.repos'), href: `/repositories` },
      { label: t('nav.graph'), href: `/graph`, desktopOnly: true }
    ].map((item, i) => {
      let href = item.href;
      if (lang !== defaultLang) {
        href = `/${lang}${href === '/' ? '' : href}`;
      }
      const isActive = Astro.url.pathname === href || Astro.url.pathname === href + '/' || (href !== '/' && Astro.url.pathname.startsWith(href + '/'));
      return <a href={href} class={`${isActive ? 'active' : ''} ${item.desktopOnly ? 'desktop-only' : ''}`.trim()}>
        {`0${i + 1} // ${item.label}`.toUpperCase()}
      </a>
    })}
  </nav>
  <div class="nav-controls" style="display: flex; gap: 16px; align-items: center;">
    <span class="cmd-chip">Cmd+K</span>
    <span style="color: var(--text-muted);">
      <a href={ptUrl} style={lang === 'pt-br' ? 'font-weight: bold; color: var(--text-color);' : 'color: inherit; text-decoration: none;'}>PT</a> | 
      <a href={enUrl} style={lang === 'en' ? 'font-weight: bold; color: var(--text-color);' : 'color: inherit; text-decoration: none;'}>EN</a>
    </span>
    <div class="theme-toggles" style="display: flex; gap: 8px; font-size: 14px;">
      <span id="btn-theme-toggle" role="button" tabindex="0" aria-label={t('cmd.toggleTheme')} style="cursor: pointer; filter: grayscale(100%);" title={t('cmd.toggleTheme')}>☀️</span>
      <span id="btn-hc-toggle" role="button" tabindex="0" aria-label={t('cmd.toggleHighContrast')} style="cursor: pointer; filter: grayscale(100%);" title={t('cmd.toggleHighContrast')}>👁️</span>
    </div>
    <noscript>
      <style>
        .theme-toggles { display: none !important; }
      </style>
    </noscript>
  </div>
</header>

<script>
  const btnTheme = document.getElementById('btn-theme-toggle');
  const btnHc = document.getElementById('btn-hc-toggle');
  
  if (typeof window !== 'undefined') {
    (window as any).__fallbackStorage = (window as any).__fallbackStorage || {};
  }

  function updateIcons() {
    const current = document.documentElement.getAttribute('data-theme') || 'Dark';
    if (btnTheme) {
      btnTheme.textContent = current.includes('Light') ? '🌙' : '☀️';
    }
    if (btnHc) {
      btnHc.textContent = current.includes('HC') ? '👁️‍🗨️' : '👁️';
    }
  }

  function setTheme(next: string) {
    document.documentElement.setAttribute('data-theme', next);
    try { window.localStorage.setItem('theme', next); } catch(err) { (window as any).__fallbackStorage['theme'] = next; }
    updateIcons();
  }

  function handleKey(e: KeyboardEvent, action: () => void) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      action();
    }
  }

  if (btnTheme) {
    const toggleTheme = () => {
      const current = document.documentElement.getAttribute('data-theme') || 'Dark';
      const isHC = current.includes('HC');
      const isLight = current.includes('Light');
      const nextTheme = isLight ? 'Dark' : 'Light';
      const next = isHC ? `HC-${nextTheme}` : nextTheme;
      setTheme(next);
      document.dispatchEvent(new CustomEvent('theme-changed', { detail: next }));
    };
    btnTheme.addEventListener('click', toggleTheme);
    btnTheme.addEventListener('keydown', (e) => handleKey(e, toggleTheme));
  }

  if (btnHc) {
    const toggleHc = () => {
      const current = document.documentElement.getAttribute('data-theme') || 'Dark';
      const isHC = current.includes('HC');
      const baseTheme = current.replace('HC-', '');
      const next = isHC ? baseTheme : `HC-${baseTheme}`;
      setTheme(next);
      document.dispatchEvent(new CustomEvent('theme-changed', { detail: next }));
    };
    btnHc.addEventListener('click', toggleHc);
    btnHc.addEventListener('keydown', (e) => handleKey(e, toggleHc));
  }

  document.addEventListener('theme-changed', () => updateIcons());

  updateIcons();
</script>
