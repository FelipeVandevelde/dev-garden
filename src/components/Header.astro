---
import { siteConfig } from '../site.config';
import { getLangFromUrl, useTranslations, getRouteWithLang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const enUrl = getRouteWithLang(Astro.url, 'en');
const ptUrl = getRouteWithLang(Astro.url, 'pt-br');
---
<header class="terminal-nav">
  <div class="nav-brand">~/felipe-dev [MONOCHROME_TERMINAL]</div>
  <nav class="nav-links">
    {siteConfig.nav.map((item, i) => {
      let href = item.href;
      if (lang !== 'en') {
        href = `/${lang}${href === '/' ? '' : href}`;
      }
      const isActive = Astro.url.pathname === href || Astro.url.pathname === href + '/' || (href !== '/' && Astro.url.pathname.startsWith(href));
      const transKey = 'nav.' + item.label.toLowerCase().replace(' ', '_');
      return <a href={href} class={isActive ? 'active' : ''}>
        {`0${i + 1} // ${t(transKey as any) || item.label}`.toUpperCase()}
      </a>
    })}
  </nav>
  <div class="nav-controls" style="display: flex; gap: 16px; align-items: center;">
    <span class="cmd-chip">Cmd+K</span>
    <span style="color: var(--text-muted);">
      <a href={ptUrl} style={lang === 'pt-br' ? 'font-weight: bold; color: var(--text-color);' : 'color: inherit; text-decoration: none;'}>PT</a> | 
      <a href={enUrl} style={lang === 'en' ? 'font-weight: bold; color: var(--text-color);' : 'color: inherit; text-decoration: none;'}>EN</a>
    </span>
    <div style="display: flex; gap: 8px; font-size: 14px;">
      <span id="btn-theme-toggle" style="cursor: pointer; filter: grayscale(100%);" title="Toggle Theme">☀️</span>
      <span id="btn-hc-toggle" style="cursor: pointer; filter: grayscale(100%);" title="Toggle High Contrast">👁️</span>
    </div>
  </div>
</header>

<script>
  const btnTheme = document.getElementById('btn-theme-toggle');
  const btnHc = document.getElementById('btn-hc-toggle');
  
  function updateIcons() {
    const current = document.documentElement.getAttribute('data-theme') || 'Dark';
    if (btnTheme) {
      btnTheme.textContent = current.includes('Light') ? '🌙' : '☀️';
    }
    if (btnHc) {
      btnHc.textContent = current.includes('HC') ? '👁️‍🗨️' : '👁️';
    }
  }

  function setTheme(next: string) {
    document.documentElement.setAttribute('data-theme', next);
    try { window.localStorage.setItem('theme', next); } catch(err) { (window as any).__fallbackStorage = (window as any).__fallbackStorage || {}; (window as any).__fallbackStorage['theme'] = next; }
    updateIcons();
  }

  if (btnTheme) {
    btnTheme.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'Dark';
      const isHC = current.includes('HC');
      const isLight = current.includes('Light');
      const nextTheme = isLight ? 'Dark' : 'Light';
      const next = isHC ? `HC-${nextTheme}` : nextTheme;
      setTheme(next);
    });
  }

  if (btnHc) {
    btnHc.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'Dark';
      const isHC = current.includes('HC');
      const baseTheme = current.replace('HC-', '');
      const next = isHC ? baseTheme : `HC-${baseTheme}`;
      setTheme(next);
    });
  }

  updateIcons();
</script>
