---
export interface Props {
  tags: string[];
  emptyMessage?: string;
}
const { tags, emptyMessage = '// No data found' } = Astro.props;
---
<div class="filter-bar" style="margin-bottom: 2rem;">
  <div aria-live="polite" class="sr-only" id="filter-announcer" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;"></div>
  <strong>Filter: </strong>
  <div class="filter-tags" style="display: inline-flex; gap: 0.5rem; flex-wrap: wrap;">
    <button class="filter-btn active" data-tag="all" aria-pressed="true">All</button>
    {tags.map((t: string) => (
      <button class="filter-btn" data-tag={t} aria-pressed="false">{t.endsWith('/') ? t : `#${t}`}</button>
    ))}
  </div>
</div>
<div class="filter-empty-state" style="display: none; padding-top: 2rem; color: var(--text-secondary); font-family: var(--font-mono);">{emptyMessage}</div>

<script is:inline>
  (function() {
    function initFilterBar() {
      const filterContainer = document.querySelector('.filter-tags');
      if (!filterContainer) return;
      
      const container = filterContainer.closest('main') || document;
      const btns = filterContainer.querySelectorAll('.filter-btn');
      const announcer = container.querySelector('#filter-announcer');

      function applyFilter(tag, updateHistory = false) {
        const items = container.querySelectorAll('.filterable-item');
        const hasFolderStructure = Array.from(items).some(
          item => item.hasAttribute('data-folder') || item.hasAttribute('data-folder-item')
        );
        const isFolderTag = typeof tag === 'string' && tag.endsWith('/');

        btns.forEach(b => {
          const isMatch = b.getAttribute('data-tag') === tag;
          b.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
          b.classList.toggle('active', isMatch);
        });

        if (updateHistory && hasFolderStructure && typeof window !== 'undefined') {
          const url = new URL(window.location.href);
          if (isFolderTag) {
            url.searchParams.set('folder', tag);
          } else {
            url.searchParams.delete('folder');
          }
          window.history.pushState({}, '', url.toString());
        }

        let visibleCount = 0;
        items.forEach(item => {
          const isFolderCard = item.hasAttribute('data-folder-item');
          const itemFolder = item.getAttribute('data-folder') || '';
          const itemTags = (item.getAttribute('data-tags') || '').split('|').map(t => t.trim());

          let shouldShow = false;

          if (!hasFolderStructure) {
            shouldShow = tag === 'all' || itemTags.includes(tag);
          } else if (tag === 'all') {
            // Root garden view: show folder cards and root-level notes (not inside a subfolder)
            shouldShow = isFolderCard || itemFolder === '';
          } else if (isFolderTag) {
            // Folder filter view: show only text pages located inside that folder
            shouldShow = !isFolderCard && itemFolder === tag;
          } else {
            // Status filter view: show notes matching status
            shouldShow = !isFolderCard && itemTags.includes(tag);
          }

          item.style.display = shouldShow ? 'block' : 'none';
          if (shouldShow) visibleCount++;
        });

        const emptyState = container.querySelector('.filter-empty-state');
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (announcer) {
          announcer.textContent = `Showing ${visibleCount} items filtered by ${tag === 'all' ? 'all' : tag}`;
        }
      }

      btns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const tag = e.currentTarget.getAttribute('data-tag') || 'all';
          applyFilter(tag, true);
        });
      });

      container.addEventListener('click', (e) => {
        const target = e.target instanceof Element ? e.target : null;
        if (!target) return;
        const folderCard = target.closest('[data-folder-item]');
        if (folderCard) {
          const folderName = folderCard.getAttribute('data-folder-item');
          if (folderName) {
            e.preventDefault();
            applyFilter(folderName, true);
          }
        }
      });

      function syncFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const folderParam = params.get('folder');
        if (folderParam) {
          const normalizedFolder = folderParam.endsWith('/') ? folderParam : folderParam + '/';
          applyFilter(normalizedFolder, false);
        } else {
          const hasFolderItems = container.querySelector('[data-folder], [data-folder-item]');
          if (hasFolderItems) {
            applyFilter('all', false);
          }
        }
      }

      window.addEventListener('popstate', syncFromUrl);
      syncFromUrl();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFilterBar);
    } else {
      initFilterBar();
    }
  })();
</script>
