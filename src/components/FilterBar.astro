---
export interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---
<div class="filter-bar" style="margin-bottom: 2rem;">
  <div aria-live="polite" class="sr-only" id="filter-announcer" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;"></div>
  <strong>Filter: </strong>
  <div class="filter-tags" style="display: inline-flex; gap: 0.5rem; flex-wrap: wrap;">
    <button class="filter-btn active" data-tag="all" aria-pressed="true">All</button>
    {tags.map((t: string) => (
      <button class="filter-btn" data-tag={t} aria-pressed="false">#{t}</button>
    ))}
  </div>
</div>

<script is:inline>
  (function() {
    const filterContainer = document.querySelector('.filter-tags');
    if (!filterContainer) return;
    
    const container = filterContainer.closest('main') || document;
    const btns = filterContainer.querySelectorAll('.filter-btn');
    const items = container.querySelectorAll('.filterable-item');
    const announcer = container.querySelector('#filter-announcer');
    
    btns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tag = e.currentTarget.getAttribute('data-tag');
        
        btns.forEach(b => {
          b.setAttribute('aria-pressed', 'false');
          b.classList.remove('active');
        });
        e.currentTarget.setAttribute('aria-pressed', 'true');
        e.currentTarget.classList.add('active');
        
        let visibleCount = 0;
        items.forEach(item => {
          if (tag === 'all') {
            item.style.display = 'block';
            visibleCount++;
          } else {
            const itemTags = item.getAttribute('data-tags') || '';
            if (itemTags.split('|').map(t => t.trim()).includes(tag)) {
              item.style.display = 'block';
              visibleCount++;
            } else {
              item.style.display = 'none';
            }
          }
        });

        if (announcer) {
          announcer.textContent = `Showing ${visibleCount} items filtered by ${tag === 'all' ? 'all' : tag}`;
        }
      });
    });
  })();
</script>