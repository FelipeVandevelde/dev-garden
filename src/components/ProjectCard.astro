---
export interface Props {
  slug: string;
  project: any;
}
const { slug, project } = Astro.props;
---
<a href={`/projects/${slug}`} class="project-card filterable-item" data-tags={project.tags.join(',')}>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <div class="tags">
    {project.tags.map((t: string) => <span class="tag">#{t}</span>)}
  </div>
</a>