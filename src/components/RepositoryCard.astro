---
export interface Props {
  slug: string;
  repo: any;
}
const { slug, repo } = Astro.props;
---
<a href={repo.url} target="_blank" class="case-card filterable-item" data-tags={repo.tags.join(',')}>
  <div class="card-header">
    <div>
      <h2 class="proj-title">{repo.title} &nearr;</h2>
      <div class="proj-meta">[{repo.language}] &bull; &starf; {repo.stars} &bull; &#9083; {repo.forks} &bull; {repo.tags.join(' \u2022 ').toUpperCase()}</div>
    </div>
  </div>
  <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.6;">{repo.description}</p>
</a>